APP_NAME=Fichow API
APP_ENV=development
DEBUG=true

API_PREFIX=/api/v1

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=*

DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/fichow_db
AUTO_CREATE_DATABASE=true
AUTO_CREATE_TABLES=true
AUTO_SEED_DATA=true

JWT_SECRET_KEY=change_this_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_COOKIE_NAME=fichow_access_token
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=lax

DEFAULT_USER_ROLE=CUSTOMER
DEFAULT_WALLET_BALANCE=100.00
DEFAULT_CURRENCY=PEN

ADMIN_EMAIL=admin@fichow.test
ADMIN_PASSWORD=Admin123
ADMIN_FULL_NAME=Fichow Admin

ENABLE_DOCS=true
